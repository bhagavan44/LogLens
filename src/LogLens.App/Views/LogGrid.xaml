<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LogLens.App.Views.LogGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    AutomationProperties.Name="Log events"
    KeyDown="OnKeyDown"
    GotFocus="OnFocusChanged"
    LostFocus="OnFocusChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Only the rows that fit on screen exist as visuals (see LogGrid.xaml.cs); the scroll bar stands in for the whole list. -->
        <Canvas
            x:Name="RowsHost"
            Background="Transparent"
            SizeChanged="OnHostSizeChanged"
            PointerPressed="OnPointerPressed"
            PointerWheelChanged="OnPointerWheelChanged" />

        <primitives:ScrollBar
            x:Name="VerticalBar"
            Grid.Column="1"
            Orientation="Vertical"
            IndicatorMode="MouseIndicator"
            SmallChange="1"
            ValueChanged="OnScrollBarValueChanged"
            AutomationProperties.Name="Scroll through log events" />
    </Grid>
</UserControl>
