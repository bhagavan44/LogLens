<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LogLens.App.Views.LogRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <!-- Height, fonts and column widths come from LogFormat; they must match the header in LogView.xaml. -->
    <Grid x:Name="RowRoot">
        <!-- Theme-aware state overlays: brushes come from theme resources, opacity does the tinting. -->
        <Border x:Name="HoverBg" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.06" Visibility="Collapsed" />
        <Border x:Name="SelectedBg" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.30" Visibility="Collapsed" />

        <Grid ColumnSpacing="8" Padding="8,0,8,0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TimeColumn" />
                <ColumnDefinition x:Name="LevelColumn" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TimeText" VerticalAlignment="Center" />
            <Border x:Name="LevelBadge" Grid.Column="1" CornerRadius="3" Height="18" VerticalAlignment="Center">
                <TextBlock x:Name="LevelText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <FontIcon x:Name="ExceptionIcon" Grid.Column="2" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </Grid>

        <Border x:Name="FocusRect" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="3"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" />
    </Grid>
</UserControl>
