<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LogLens.App.Views.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UX-2: the drop zone. The whole window accepts dropped files (MainWindow.OnDrop); this only says so. -->
    <Grid Padding="32">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="560"
            Padding="48,40"
            CornerRadius="8"
            BorderThickness="2"
            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <FontIcon
                    Glyph="&#xE8B5;"
                    FontSize="48"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="Drop log files or a folder here"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="or open them with the buttons below (Ctrl+O, Ctrl+Shift+O, Ctrl+Shift+R for a remote host). Each file opens in a tab, or merge several into one view. LogLens reads logs written by Serilog, NLog and log4net, and never changes them."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Open files…" Style="{StaticResource AccentButtonStyle}" Click="OnOpenClick" />
                    <Button Content="Open folder…" Click="OnOpenFolderClick" />
                    <Button Content="Remote host…" Click="OnOpenRemoteClick" ToolTipService.ToolTip="Open logs from an SSH host or a Windows share (Ctrl+Shift+R)" />
                </StackPanel>

                <!-- UX-2: recent files, newest first. -->
                <StackPanel x:Name="RecentPanel" Margin="0,16,0,0" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Recent files" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <StackPanel x:Name="RecentList" Spacing="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
