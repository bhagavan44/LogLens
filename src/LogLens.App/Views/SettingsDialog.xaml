<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LogLens.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- The default dialog is too narrow for the hide rule editor. -->
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Brushes come from styles (not looked up in code) so they follow the dialog's theme, not the app's. -->
        <Style x:Key="ErrorHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer x:Name="Scroller" Width="720" MaxHeight="620" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
        <StackPanel Spacing="10">

            <!-- ===== Appearance (FR-P1, FR-P2) ===== -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="ThemeBox" Header="Theme" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Use the Windows setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
                <RadioButtons x:Name="DensityButtons" Grid.Column="1" Header="Row density" MaxColumns="2">
                    <RadioButton Content="Comfortable" />
                    <RadioButton Content="Compact" />
                </RadioButtons>
                <ComboBox
                    x:Name="FontBox"
                    Grid.Row="1"
                    Header="Font for log text"
                    IsEditable="True"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.HelpText="Pick a font or type the name of one installed on this PC. Inter comes with LogLens." />
                <NumberBox
                    x:Name="FontSizeBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Header="Font size"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    ValueChanged="OnFontSizeChanged" />
            </Grid>

            <!-- ===== Timestamps (FR-G5, FR-P3) ===== -->
            <TextBlock Text="Timestamps" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ZoneBox" Header="Show times" HorizontalAlignment="Stretch" SelectionChanged="OnZoneChanged">
                    <ComboBoxItem Content="As logged" />
                    <ComboBoxItem Content="In this PC's time zone" />
                    <ComboBoxItem Content="In UTC" />
                </ComboBox>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox x:Name="FormatBox" Header="Format" FontFamily="Cascadia Mono, Consolas" TextChanged="OnFormatChanged"
                             AutomationProperties.HelpText="A .NET custom date and time format, for example yyyy-MM-dd HH:mm:ss.fff" />
                    <TextBlock x:Name="FormatPreview" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The time filter, the query bar's @t and Go to read times in the zone shown. The detail pane always adds the offset." />

            <!-- ===== Start-up (FR-P3) ===== -->
            <TextBlock Text="Opening and following" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <ToggleSwitch x:Name="RestoreSessionSwitch" Header="Reopen last time's tabs when LogLens starts" />
            <ToggleSwitch x:Name="TailSwitch" Header="Show new events as they are written (Tail) as soon as a file opens" />

            <!-- ===== Formats: custom output templates (FR-F1, FR-F2) ===== -->
            <TextBlock Text="Formats" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="LogLens recognises Serilog text (the default template), compact JSON (CLEF) and classic JSON by itself. If your app writes text logs with its own output template, add it here: it is tried when a file opens and offered under View ▸ Format. Property tokens such as {SourceContext} or {ThreadId} become properties you can filter on." />
            <StackPanel x:Name="TemplatesPanel" Spacing="12" />
            <TextBlock x:Name="NoTemplatesText" Text="No custom templates yet." Style="{StaticResource Hint}" />
            <Button Content="Add template" Click="OnAddTemplateClick" AutomationProperties.Name="Add custom output template" />

            <!-- ===== Hide rules (FR-S6) ===== -->
            <TextBlock Text="Hide rules" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Events matching a rule that is switched on are left out of every log, like a filter that is always on. Rules use the query bar's syntax, e.g. @m startswith 'Health check' or @l = 'Verbose'. The Hiding noise button in a log shows them again for a moment." />
            <StackPanel x:Name="RulesPanel" Spacing="8" />
            <TextBlock x:Name="NoRulesText" Text="No hide rules yet." Style="{StaticResource Hint}" />
            <Button Content="Add rule" Click="OnAddRuleClick" AutomationProperties.Name="Add hide rule" />

            <!-- ===== Saved filters (FR-S7) ===== -->
            <TextBlock Text="Saved filters" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="SavedFiltersText" Style="{StaticResource Hint}" />

            <!-- ===== Open with (FR-P5) ===== -->
            <TextBlock Text="Open with (this Windows user only)" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Adds LogLens to Explorer's Open with menu for these file types. Your default program for each type stays as it is, and no administrator rights are needed. After moving or updating the exe, register again." />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="LogCheck" Content=".log" Tag=".log" />
                <CheckBox x:Name="ClefCheck" Content=".clef" Tag=".clef" />
                <CheckBox x:Name="TxtCheck" Content=".txt" Tag=".txt" />
                <CheckBox x:Name="JsonCheck" Content=".json" Tag=".json" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RegisterButton" Content="Register" Click="OnRegisterClick" AutomationProperties.Name="Register for Open with" />
                <Button x:Name="UnregisterButton" Content="Remove" Click="OnUnregisterClick" AutomationProperties.Name="Remove from Open with" />
            </StackPanel>
            <TextBlock x:Name="AssociationStatusText" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />

            <!-- ===== Settings file (FR-P4) and folders (FR-P6, NFR-12) ===== -->
            <TextBlock Text="Settings file and folders" Style="{StaticResource SectionHeader}" AutomationProperties.HeadingLevel="Level2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export…" Click="OnExportClick" ToolTipService.ToolTip="Save these settings to a file, e.g. to use them on another PC"
                        AutomationProperties.Name="Export settings" />
                <Button Content="Import…" Click="OnImportClick" ToolTipService.ToolTip="Load settings from a file. Nothing changes until you press Save."
                        AutomationProperties.Name="Import settings" />
                <Button Content="Open settings folder" Click="OnOpenSettingsFolderClick" />
                <Button Content="Open diagnostics folder" Click="OnOpenLogsFolderClick" />
            </StackPanel>
            <TextBlock x:Name="FileStatusText" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="DataDirText" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
