<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LogLens.App.Views.GoToDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Go to event or time"
    PrimaryButtonText="Go"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnGoClick">

    <StackPanel Spacing="8" MinWidth="340">
        <TextBox
            x:Name="InputBox"
            PlaceholderText="1200   or   08:00:05   or   2026-11-13 08:00"
            AutomationProperties.Name="Event number or time" />
        <TextBlock
            x:Name="ErrorText"
            Visibility="Collapsed"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="A time takes you to the first shown event at or after it. A time without a date uses the date of the first event." />
    </StackPanel>
</ContentDialog>
