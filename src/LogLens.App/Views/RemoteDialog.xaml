<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LogLens.App.Views.RemoteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open from remote host"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
        <!-- A part of the folder path, or the arrow after it: no fill until the pointer is over it -->
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="720" Height="430">

        <!-- 1. The hosts -->
        <Grid x:Name="HostsPanel" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Text="Choose a host, then pick log files from its folders. SSH hosts are read over SFTP (read-only); hosts from your ~/.ssh/config are listed too."
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView
                x:Name="HostList"
                Grid.Row="1"
                SelectionMode="Single"
                SelectionChanged="OnHostSelectionChanged"
                DoubleTapped="OnHostDoubleTapped"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                AutomationProperties.Name="Remote hosts" />
            <TextBlock
                x:Name="NoHostsText"
                Grid.Row="1"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No hosts yet. Add an SSH host (for example an Ubuntu server) or a Windows share." />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Add host…" Click="OnAddHostClick" />
                <Button x:Name="EditHostButton" Content="Edit…" Click="OnEditHostClick" IsEnabled="False" />
                <Button x:Name="RemoveHostButton" Content="Remove" Click="OnRemoveHostClick" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="HostsError" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </Grid>

        <!-- 2. Adding or editing a host -->
        <ScrollViewer x:Name="EditPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnBackToHostsClick" ToolTipService.ToolTip="Back to the hosts" AutomationProperties.Name="Back to the hosts" Padding="8,4">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="EditTitle" Text="Add host" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>

                <RadioButtons x:Name="KindBox" Header="Connect with" MaxColumns="2" SelectionChanged="OnKindChanged">
                    <x:String>SSH (SFTP)</x:String>
                    <x:String>Windows share</x:String>
                </RadioButtons>

                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Shown in the list; the host name if left empty" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" Header="Host name or IP address" PlaceholderText="web01.example.com" />
                    <NumberBox x:Name="PortBox" Grid.Column="1" Header="Port" Minimum="1" Maximum="65535" Value="22" SpinButtonPlacementMode="Hidden" />
                </Grid>

                <StackPanel x:Name="SshFields" Spacing="10">
                    <TextBox x:Name="UserBox" Header="User name" PlaceholderText="ubuntu" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyFileBox" Header="Private key file (optional)" PlaceholderText="Empty: id_ed25519, id_ecdsa or id_rsa in your .ssh folder; then a password" />
                        <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnBrowseKeyClick" />
                    </Grid>
                    <TextBox x:Name="StartFolderBox" Header="Start folder (optional)" PlaceholderText="/var/log — empty for your home folder" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Name="ForgetKeyButton" Content="Forget host key" Padding="0,2" Click="OnForgetKeyClick"
                                         ToolTipService.ToolTip="Forget the host key accepted in LogLens, so it is checked again on the next connect (keys in ~/.ssh/known_hosts are not touched)" />
                        <TextBlock x:Name="ForgetKeyResult" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Name="ShareHint"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Windows signs in to the share. If it needs other credentials, open the share once in File Explorer first." />
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Passwords and key passphrases are never saved: they are asked for when connecting and kept in memory until LogLens closes." />
                <TextBlock x:Name="EditError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Connecting -->
        <StackPanel x:Name="ConnectingPanel" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="32" Height="32" />
            <TextBlock x:Name="ConnectingText" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <!-- 4. A question while connecting: password, passphrase or an unknown host key -->
        <StackPanel x:Name="PromptPanel" Visibility="Collapsed" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnPromptBackClick" ToolTipService.ToolTip="Cancel and go back to the hosts" AutomationProperties.Name="Cancel and go back to the hosts" Padding="8,4">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock x:Name="PromptTitle" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <TextBlock x:Name="PromptMessage" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="PromptFingerprint" Visibility="Collapsed" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" />
            <PasswordBox x:Name="PromptPassword" Width="360" HorizontalAlignment="Left" />
            <TextBlock x:Name="PromptProblem" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- 5. Browsing the host's folders -->
        <Grid x:Name="BrowsePanel" Visibility="Collapsed" RowSpacing="8" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnTypePathInvoked" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="OnBackToHostsClick" ToolTipService.ToolTip="Back to the hosts" AutomationProperties.Name="Back to the hosts" Padding="8,4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock x:Name="BrowseHost" Grid.Column="1" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!-- The folder's path: each part opens its folder, the arrow after it lists that folder's sub-folders, the empty space types a path -->
                <Border
                    x:Name="CrumbBar"
                    Grid.Column="2"
                    MinHeight="32"
                    Padding="2,0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Tapped="OnCrumbBarTapped"
                    SizeChanged="OnCrumbBarSizeChanged"
                    ToolTipService.ToolTip="Click to type a folder (Ctrl+L)">
                    <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" AutomationProperties.Name="Folder path" />
                </Border>
                <TextBox
                    x:Name="FolderBox"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    KeyDown="OnFolderBoxKeyDown"
                    LostFocus="OnFolderBoxLostFocus"
                    AutomationProperties.Name="Folder"
                    ToolTipService.ToolTip="Type a folder and press Enter (Esc goes back to the path)" />
                <Button x:Name="UpButton" Grid.Column="3" Click="OnUpClick" ToolTipService.ToolTip="Up one folder" AutomationProperties.Name="Up one folder" Padding="8,4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Grid.Column="4" Click="OnRefreshClick" ToolTipService.ToolTip="Read the folder again" AutomationProperties.Name="Refresh" Padding="8,4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListView
                    x:Name="FolderList"
                    SelectionMode="Single"
                    DoubleTapped="OnFolderDoubleTapped"
                    KeyDown="OnFolderListKeyDown"
                    ToolTipService.ToolTip="Double-click a folder to open it"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    AutomationProperties.Name="Folders" />
                <TextBlock
                    x:Name="NoFoldersText"
                    Text="No sub-folders"
                    Margin="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- The files: filter and order above the list -->
                <Grid Grid.Column="1" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="FilterBox"
                            PlaceholderText="Filter files by name"
                            TextChanged="OnFilterChanged"
                            AutomationProperties.Name="Filter files by name"
                            ToolTipService.ToolTip="Show only the files whose name contains this text" />
                        <ComboBox
                            x:Name="SortBox"
                            Grid.Column="1"
                            Width="190"
                            SelectedIndex="2"
                            SelectionChanged="OnSortChanged"
                            AutomationProperties.Name="Sort files"
                            ToolTipService.ToolTip="Order of the files">
                            <x:String>Name (A–Z)</x:String>
                            <x:String>Name (Z–A)</x:String>
                            <x:String>Modified (newest first)</x:String>
                            <x:String>Modified (oldest first)</x:String>
                        </ComboBox>
                    </Grid>
                    <ListView
                        x:Name="FileList"
                        Grid.Row="1"
                        SelectionMode="Multiple"
                        SelectionChanged="OnFileSelectionChanged"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        AutomationProperties.Name="Log files in the folder" />
                    <TextBlock
                        x:Name="NoFilesText"
                        Grid.Row="1"
                        Text="No matching files here. Change the pattern below to see other files."
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="BrowseError"
                        Grid.Row="1"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Grid>
                <ProgressRing x:Name="BrowseBusy" Grid.ColumnSpan="2" IsActive="False" Width="28" Height="28" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PatternBox" PlaceholderText="*.txt;*.log;*.json;*.clef" TextChanged="OnPatternChanged" AutomationProperties.Name="Files matching" ToolTipService.ToolTip="Files matching (separate patterns with ;)" />
                <TextBlock x:Name="SummaryText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton Content="Select all" Padding="6,2" FontSize="12" Click="OnSelectAllClick" />
                    <HyperlinkButton Content="Select none" Padding="6,2" FontSize="12" Click="OnSelectNoneClick" />
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Text="Remote files are read over the connection and can be tailed like local ones. Merging makes a snapshot that does not follow new events."
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</ContentDialog>
