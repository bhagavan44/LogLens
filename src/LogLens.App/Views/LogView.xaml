<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LogLens.App.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LogLens.App.Views"
    xmlns:vm="using:LogLens.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="640" />
        </Grid.ColumnDefinitions>

        <!-- ===== Filter bar: query (FR-S4), levels (FR-S1), time window (FR-S2), quick-filter chips (FR-S5) ===== -->
        <StackPanel Grid.ColumnSpan="2" Padding="8,8,8,6" Spacing="6">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="QueryBox"
                    Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Filter…   e.g.   @l >= 'Warning' and @m like '%payment%'"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    AutomationProperties.Name="Filter query"
                    AutomationProperties.HelpText="Press Enter to apply now, Escape to clear."
                    KeyDown="OnQueryKeyDown" />
                <Button Grid.Column="1" Content="?" VerticalAlignment="Stretch" AutomationProperties.Name="Filter syntax help"
                        ToolTipService.ToolTip="Filter syntax">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="460" Spacing="6">
                                <TextBlock Text="Filter syntax" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Text="Fields: @l level · @t timestamp · @m message · @x exception." />
                                <TextBlock TextWrapping="Wrap" Text="Operators: = != &lt; &lt;= &gt; &gt;= · in [...] · like (% and _) · contains · startswith · endswith · matches (regex) · exists(@x) · and / or / not · ( )" />
                                <TextBlock TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                           Text="@l in ['Error','Fatal']&#x0A;@l >= 'Warning' and @m like '%payment%'&#x0A;@t >= '2026-11-13 08:00' and @t &lt; '2026-11-13 09:00'&#x0A;exists(@x) and not @x contains 'Timeout'" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Text comparisons ignore case. Put text in quotes. Times are compared as shown in the grid." />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock
                Text="{x:Bind ViewModel.QueryError, Mode=OneWay}"
                Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasQueryError), Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />

            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LevelToggles}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LevelToggle">
                                <ToggleButton
                                    IsChecked="{x:Bind IsOn, Mode=TwoWay}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTipService.ToolTip="{x:Bind Description}"
                                    AutomationProperties.Name="{x:Bind Description}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="4" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                                Background="{x:Bind local:LogFormat.BadgeBackground(Level)}" />
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CountText}" Opacity="0.75" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.MinLevelOptions}"
                        SelectedIndex="{x:Bind ViewModel.MinLevelIndex, Mode=TwoWay}"
                        PlaceholderText="Custom levels"
                        FontSize="12"
                        MinWidth="160"
                        AutomationProperties.Name="Minimum level" />

                    <DropDownButton
                        x:Name="TimeButton"
                        Content="{x:Bind ViewModel.TimeButtonLabel, Mode=OneWay}"
                        FontSize="12"
                        AutomationProperties.Name="Time window">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="340" Spacing="8">
                                    <TextBlock Text="Last part of the log" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="5 min" Tag="300" Click="OnLastClick" />
                                        <Button Content="15 min" Tag="900" Click="OnLastClick" />
                                        <Button Content="1 hour" Tag="3600" Click="OnLastClick" />
                                        <Button Content="24 hours" Tag="86400" Click="OnLastClick" />
                                    </StackPanel>
                                    <TextBlock Text="Around the selected event" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="± 30 s" Tag="30" Click="OnAroundClick" />
                                        <Button Content="± 5 min" Tag="300" Click="OnAroundClick" />
                                        <Button Content="± 1 hour" Tag="3600" Click="OnAroundClick" />
                                    </StackPanel>
                                    <TextBlock Text="Custom range" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBox Header="From" Text="{x:Bind ViewModel.TimeFromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="2026-11-13 08:00:00  (or just 08:00)"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12" KeyDown="OnTimeBoxKeyDown" />
                                    <TextBox Header="To" Text="{x:Bind ViewModel.TimeToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Leave empty for no end"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12" KeyDown="OnTimeBoxKeyDown" />
                                    <TextBlock Text="{x:Bind ViewModel.TimeError, Mode=OneWay}"
                                               Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasTimeError), Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Click="OnApplyTimeClick" />
                                        <Button Content="Clear time filter" Click="OnClearTimeClick" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Times are the ones shown in the grid." />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button
                        Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasActivePin), Mode=OneWay}"
                        FontSize="12"
                        ToolTipService.ToolTip="Showing only events like this one. Click to remove."
                        AutomationProperties.Name="Remove the show-only filter"
                        Click="OnClearPinClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ActivePinLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <Button
                        Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasHiddenGroups), Mode=OneWay}"
                        FontSize="12"
                        ToolTipService.ToolTip="{x:Bind ViewModel.HiddenGroupsList, Mode=OneWay}"
                        AutomationProperties.Name="Show the hidden kinds of event again"
                        Click="OnClearHiddenGroupsClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.HiddenGroupsLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <HyperlinkButton
                        Content="Clear filters"
                        FontSize="12"
                        Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasActiveFilters), Mode=OneWay}"
                        Click="OnClearFiltersClick" />

                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsFiltering, Mode=OneWay}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Filtering" />

                    <!-- ===== Live log (FR-T1, FR-T5, FR-T7) ===== -->
                    <AppBarSeparator Padding="0" />
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsFollowing, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanFollow, Mode=OneWay}"
                        FontSize="12"
                        ToolTipService.ToolTip="Show new events as they are written (Ctrl+T)"
                        AutomationProperties.Name="Tail">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Tail" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                        Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.IsFollowing), Mode=OneWay}"
                        FontSize="12"
                        ToolTipService.ToolTip="Hold back new events so the list stays still; they are kept and shown on resume"
                        AutomationProperties.Name="Pause tail">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE769;" FontSize="12" />
                            <TextBlock Text="Pause" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Visibility="{x:Bind local:LogView.ToVisibilityUnless(ViewModel.IsFollowing), Mode=OneWay}"
                        FontSize="12"
                        ToolTipService.ToolTip="Read what was written since (F5)"
                        AutomationProperties.Name="Refresh"
                        Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- ===== Find bar, Ctrl+F (FR-S3) ===== -->
        <ScrollViewer
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.FindBarVisible), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Padding="8,6" Spacing="6">
                <TextBox
                    x:Name="FindBox"
                    Width="280"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Find in messages"
                    AutomationProperties.Name="Find text"
                    AutomationProperties.HelpText="Enter finds the next match, Shift+Enter the previous one, Escape closes the find bar."
                    KeyDown="OnFindKeyDown" />
                <ToggleButton Content="Aa" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" ToolTipService.ToolTip="Match case" AutomationProperties.Name="Match case" />
                <ToggleButton Content="Word" IsChecked="{x:Bind ViewModel.WholeWord, Mode=TwoWay}" ToolTipService.ToolTip="Whole word" AutomationProperties.Name="Whole word" />
                <ToggleButton Content=".*" IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}" ToolTipService.ToolTip="Regular expression" AutomationProperties.Name="Regular expression" />
                <ToggleButton Content="Exception" IsChecked="{x:Bind ViewModel.IncludeException, Mode=TwoWay}" ToolTipService.ToolTip="Also search exception text" AutomationProperties.Name="Include exception text" />
                <Button Click="OnFindPreviousClick" ToolTipService.ToolTip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match" VerticalAlignment="Stretch">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button Click="OnFindNextClick" ToolTipService.ToolTip="Next match (F3)" AutomationProperties.Name="Next match" VerticalAlignment="Stretch">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.MatchSummary, Mode=OneWay}" MinWidth="80" VerticalAlignment="Center" Margin="4,0"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Matches" />
                <ToggleButton Content="Only matches" IsChecked="{x:Bind ViewModel.OnlyMatches, Mode=TwoWay}" ToolTipService.ToolTip="Show only the events that match" />
                <StackPanel Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="With Only matches: also show this many events before and after each match">
                    <TextBlock Text="Context ±" VerticalAlignment="Center" />
                    <NumberBox
                        x:Name="ContextBox"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Width="104"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnContextChanged"
                        AutomationProperties.Name="Context events around each match" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SearchError, Mode=OneWay}"
                           Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasSearchError), Mode=OneWay}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Click="OnCloseFindClick" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close find bar" VerticalAlignment="Stretch">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Event list ===== -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column widths are set from LogFormat in code so they always match LogRow. -->
            <Grid
                Height="30"
                Padding="8,0,8,0"
                ColumnSpacing="8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                AutomationProperties.AccessibilityView="Raw">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTimeColumn" />
                    <ColumnDefinition x:Name="HeaderLevelColumn" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Time" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Level" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Message" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <local:LogGrid
                x:Name="EventGrid"
                Grid.Row="1"
                SelectionChanged="OnGridSelectionChanged"
                CopyRequested="OnCopyRequested">
                <local:LogGrid.ContextFlyout>
                    <MenuFlyout Opening="OnRowMenuOpening">
                        <MenuFlyoutItem Text="Copy" Click="OnCopyClick" KeyboardAcceleratorTextOverride="Ctrl+C" />
                        <MenuFlyoutItem Text="Copy original lines" Click="OnCopyRawClick" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="RowShowLikeItem" Text="Show only events like this one" Click="OnRowShowLikeClick" />
                        <MenuFlyoutItem x:Name="RowHideLikeItem" Text="Hide events like this one" Click="OnRowHideLikeClick" />
                        <MenuFlyoutItem x:Name="RowOnlyLevelItem" Text="Show only this level" Click="OnRowOnlyLevelClick" />
                        <MenuFlyoutItem x:Name="RowHideLevelItem" Text="Hide this level" Click="OnRowHideLevelClick" />
                        <MenuFlyoutItem x:Name="RowAroundItem" Text="Show events within ± 30 s of this one" Click="OnRowAroundClick" />
                    </MenuFlyout>
                </local:LogGrid.ContextFlyout>
            </local:LogGrid>

            <TextBlock
                Grid.Row="1"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.ShowNoMatches), Mode=OneWay}"
                Text="No events match the filters." />

            <!-- FR-T2: new events arrived while the list was scrolled away from the end. -->
            <Button
                Grid.Row="1"
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Style="{StaticResource AccentButtonStyle}"
                CornerRadius="16"
                Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.HasPendingNewEvents), Mode=OneWay}"
                AutomationProperties.LiveSetting="Polite"
                Click="OnJumpToLatestClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.PendingNewEventsLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Detail pane (FR-D1 … FR-D4) ===== -->
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Padding="12,8,12,12"
            RowSpacing="6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Text="{x:Bind ViewModel.DetailHeader, Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="True" />
            <TextBlock
                Grid.Row="1"
                Text="{x:Bind ViewModel.MetadataText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="True"
                AutomationProperties.Name="Event location" />

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="DetailTabs" SelectionChanged="OnDetailTabChanged" AutomationProperties.Name="Detail view">
                    <SelectorBarItem x:Name="MessageTab" Text="Message" IsSelected="True" />
                    <SelectorBarItem x:Name="ExceptionTab" Text="Exception" />
                    <SelectorBarItem x:Name="RawTab" Text="Raw" />
                </SelectorBar>
                <Button
                    x:Name="CopyExceptionButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Copy exception"
                    Visibility="Collapsed"
                    IsEnabled="{x:Bind ViewModel.HasException, Mode=OneWay}"
                    Click="OnCopyExceptionClick" />
            </Grid>

            <Grid Grid.Row="3">
                <TextBox
                    x:Name="MessageBox"
                    Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Message"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBox
                    x:Name="ExceptionBox"
                    Visibility="Collapsed"
                    Text="{x:Bind ViewModel.ExceptionText, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Exception"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBox
                    x:Name="RawBox"
                    Visibility="Collapsed"
                    Text="{x:Bind ViewModel.RawText, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Raw event text"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Padding="12,4"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="Status" />
                <!-- UX-4: the first read runs in the background; the list is usable meanwhile. -->
                <ProgressBar
                    Grid.Column="1"
                    Width="120"
                    Maximum="1"
                    VerticalAlignment="Center"
                    Value="{x:Bind ViewModel.LoadProgress, Mode=OneWay}"
                    Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.IsLoading), Mode=OneWay}"
                    AutomationProperties.Name="Loading progress" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.TailStatus, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Live state" />
                <HyperlinkButton
                    Grid.Column="3"
                    Padding="4,0"
                    FontSize="12"
                    Content="Stop"
                    Visibility="{x:Bind local:LogView.ToVisibility(ViewModel.IsLoading), Mode=OneWay}"
                    ToolTipService.ToolTip="Stop reading the file; what was read stays"
                    AutomationProperties.Name="Stop loading"
                    Click="OnStopLoadingClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
