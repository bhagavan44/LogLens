<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LogLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LogLens.App.Views"
    Title="LogLens">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the window content extends into it; the tab strip moves here in v0.4). -->
        <Grid x:Name="AppTitleBar" Height="32" Padding="12,0,0,0" ColumnSpacing="8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="LogLens" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <MenuBar Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open…" Click="OnOpen">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!-- FR-O1: filled from MainViewModel.RecentFiles. -->
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent files">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="CloseItem" Text="Close" Click="OnClose" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="FindItem" Text="Find…" Click="OnFind" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FindNextItem" Text="Find next" Click="OnFindNext" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FindPreviousItem" Text="Find previous" Click="OnFindPrevious" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Shift" Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FilterItem" Text="Filter query…" Click="OnFocusFilter" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ClearFiltersItem" Text="Clear all filters" Click="OnClearFilters" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="TailItem" Text="Tail" Click="OnTailClick" IsEnabled="False">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="T" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="PauseItem" Text="Pause tail" Click="OnPauseClick" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Name="FollowRolledItem" Text="Follow the next file of a rolling log" Click="OnFollowRolledClick" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="RefreshItem" Text="Refresh" Click="OnRefreshClick" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Navigate">
                <MenuFlyoutItem x:Name="GoToItem" Text="Go to event or time…" Click="OnGoTo" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="NextProblemItem" Text="Next warning or error" Click="OnNextProblem" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PreviousProblemItem" Text="Previous warning or error" Click="OnPreviousProblem" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About LogLens" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- UX-3 / UX-7: non-blocking errors and hints. -->
        <InfoBar x:Name="NoticeBar" Grid.Row="2" Margin="8,0,8,8" IsOpen="False" Closed="OnNoticeClosed" />

        <Grid Grid.Row="3">
            <views:EmptyStateView x:Name="EmptyState" OpenRequested="OnEmptyStateOpen" RecentFileRequested="OnRecentFileRequested" />
            <ContentControl x:Name="LogHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />

            <!-- Shown until the file being opened has its first rows; the current log stays meanwhile and the open can be cancelled. -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24" CornerRadius="8"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" MinWidth="320">
                    <TextBlock x:Name="LoadingText" TextTrimming="CharacterEllipsis" />
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Opening" />
                    <Button Content="Cancel" HorizontalAlignment="Right" Click="OnCancelLoad" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
