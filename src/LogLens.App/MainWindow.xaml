<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LogLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LogLens.App.Views"
    Title="LogLens">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- UX-7: shown where Mica is not supported (Windows 10). A theme resource, so it follows the theme the user picked (FR-P1). -->
        <Border x:Name="SolidBackground" Grid.RowSpan="4" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!--
            UX-7: the tab strip is the title bar (FR-O2). The TabView holds only the tabs' headers; the log in front is shown in LogHost below
            the menu. The footer is the part of the strip that drags the window (SetTitleBar); it is kept at least as wide as the caption
            buttons (UpdateTitleBarInset), so tabs never run under them.
        -->
        <TabView
            x:Name="Tabs"
            Height="40"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="False"
            TabWidthMode="SizeToContent"
            VerticalAlignment="Top"
            AddTabButtonClick="OnAddTabClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged"
            TabItemsChanged="OnTabItemsChanged"
            AutomationProperties.Name="Open logs">
            <TabView.Resources>
                <!-- Tabs sit on the bottom edge of the strip. -->
                <Thickness x:Key="TabViewHeaderPadding">8,8,8,0</Thickness>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <!-- Decoded at display size (Logical = scale-aware) so the downscale stays sharp. -->
                <Image Width="20" Height="20" Margin="12,8,6,0" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/AppIcon.png" DecodePixelType="Logical"
                                     DecodePixelWidth="20" DecodePixelHeight="20" />
                    </Image.Source>
                </Image>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="TitleDragRegion" MinWidth="138" MinHeight="40" Background="Transparent">
                    <!-- With no tab open, the strip still names the app. -->
                    <TextBlock x:Name="TitleText" Text="LogLens" Margin="8,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Shorter than the default 40 px (and 4 px item margins), so the filter bar sits close under the menu. -->
        <MenuBar Grid.Row="1" MinHeight="30">
            <MenuBar.Resources>
                <Thickness x:Key="MenuBarItemMargin">4,2,4,2</Thickness>
            </MenuBar.Resources>
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open…" Click="OnOpen">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open folder…" Click="OnOpenFolder">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open from remote host…" Click="OnOpenRemote">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE968;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Merge files into one view…" Click="OnMergeFiles" />
                <!-- FR-O1: filled from MainViewModel.RecentFiles. -->
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent files">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExportItem" Text="Export…" Click="OnExport" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CloseItem" Text="Close tab" Click="OnClose" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CloseOthersItem" Text="Close other tabs" Click="OnCloseOthers" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <!-- Ctrl+, has no named VirtualKey: the accelerator is added in code. -->
                <MenuFlyoutItem x:Name="SettingsItem" Text="Settings…" Click="OnSettings" KeyboardAcceleratorTextOverride="Ctrl+,">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="FindItem" Text="Find…" Click="OnFind" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FindNextItem" Text="Find next" Click="OnFindNext" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FindPreviousItem" Text="Find previous" Click="OnFindPrevious" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Shift" Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="FindAllItem" Text="Find all events containing…" Click="OnFindAll" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FilterItem" Text="Filter query…" Click="OnFocusFilter" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ClearFiltersItem" Text="Clear all filters" Click="OnClearFilters" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="TailItem" Text="Tail" Click="OnTailClick" IsEnabled="False">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="T" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="PauseItem" Text="Pause tail" Click="OnPauseClick" IsEnabled="False">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="P" />
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="FollowRolledItem" Text="Follow the next file of a rolling log" Click="OnFollowRolledClick" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="RefreshItem" Text="Refresh" Click="OnRefreshClick" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="BookmarksPanelItem" Text="Bookmarks panel" Click="OnBookmarksPanelClick" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="TimelineItem" Text="Timeline" Click="OnTimelineClick" />
                <ToggleMenuFlyoutItem x:Name="StatisticsItem" Text="Statistics" Click="OnStatisticsClick" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem x:Name="NewestFirstItem" Text="Newest events first" Click="OnNewestFirstClick" />
                <ToggleMenuFlyoutItem x:Name="WrapItem" Text="Wrap long messages" Click="OnWrapClick" />
                <MenuFlyoutSubItem x:Name="TimeColumnMenu" Text="Time column" IsEnabled="False">
                    <RadioMenuFlyoutItem x:Name="TimeTimestampItem" Text="Timestamp" GroupName="TimeColumn" IsChecked="True" Tag="Timestamp" Click="OnTimeModeClick" />
                    <RadioMenuFlyoutItem x:Name="TimeSincePreviousItem" Text="Time since the previous event" GroupName="TimeColumn" Tag="SincePrevious" Click="OnTimeModeClick" />
                    <RadioMenuFlyoutItem x:Name="TimeSinceSelectedItem" Text="Time since the selected event" GroupName="TimeColumn" Tag="SinceSelected" Click="OnTimeModeClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <!-- FR-F1: the format the log in front is read with; items are added in code (built-in formats and custom templates). -->
                <MenuFlyoutSubItem x:Name="FormatMenu" Text="Format" IsEnabled="False">
                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="Navigate">
                <MenuFlyoutItem x:Name="GoToItem" Text="Go to event or time…" Click="OnGoTo" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="NextProblemItem" Text="Next warning or error" Click="OnNextProblem" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PreviousProblemItem" Text="Previous warning or error" Click="OnPreviousProblem" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="E" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ToggleBookmarkItem" Text="Toggle bookmark" Click="OnToggleBookmark" IsEnabled="False">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="NextBookmarkItem" Text="Next bookmark" Click="OnNextBookmark" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PreviousBookmarkItem" Text="Previous bookmark" Click="OnPreviousBookmark" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Shift" Key="F2" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ClearBookmarksItem" Text="Clear bookmarks of this log" Click="OnClearBookmarks" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="NextTabItem" Text="Next tab" Click="OnNextTab" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Tab" />
                <MenuFlyoutItem x:Name="PreviousTabItem" Text="Previous tab" Click="OnPreviousTab" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Shift+Tab" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnShortcuts">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Show the first-run hints again" Click="OnShowHints" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About LogLens" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- UX-3 / UX-7: non-blocking errors and hints. -->
        <InfoBar x:Name="NoticeBar" Grid.Row="2" Margin="8,0,8,8" IsOpen="False" Closed="OnNoticeClosed" />

        <Grid Grid.Row="3">
            <views:EmptyStateView x:Name="EmptyState" OpenRequested="OnEmptyStateOpen" OpenFolderRequested="OnEmptyStateOpenFolder"
                                  OpenRemoteRequested="OnEmptyStateOpenRemote" RecentFileRequested="OnRecentFileRequested" />
            <ContentControl x:Name="LogHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />

            <!-- Shown until a file being opened has its first rows; the open tabs stay meanwhile and the open can be cancelled. -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24" CornerRadius="8"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" MinWidth="320">
                    <TextBlock x:Name="LoadingText" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Opening" />
                    <Button Content="Cancel" HorizontalAlignment="Right" Click="OnCancelLoad" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- First-run hints (UX-7), shown one after the other the first time a log is open; see MainWindow.Hints.cs. -->
        <TeachingTip
            x:Name="FilterTip"
            Title="Find what matters"
            Subtitle="Type a query such as @l >= 'Warning' (Ctrl&#x2060;+&#x2060;L); ? lists the syntax. Right-click a row to show or hide events like it. Saved keeps a filter for later."
            PreferredPlacement="Bottom"
            ActionButtonContent="Next"
            CloseButtonContent="Skip"
            ActionButtonClick="OnFilterTipNext" />
        <TeachingTip
            x:Name="TabsTip"
            Title="Several logs at once"
            Subtitle="Open more files with + or by dropping them on the window. File ▸ Merge files into one view puts them on one timeline. F1 lists every shortcut."
            PreferredPlacement="Bottom"
            CloseButtonContent="Got it" />
    </Grid>
</Window>
