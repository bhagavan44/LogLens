<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\serilog-text\*.txt" LinkBase="samples\serilog-text" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\serilog-clef\*.clef" LinkBase="samples\serilog-clef" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\serilog-json\*.json" LinkBase="samples\serilog-json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\nlog\*.log" LinkBase="samples\nlog" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\log4net\*.log" LinkBase="samples\log4net" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\regex\*.log" LinkBase="samples\regex" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogLens.Infrastructure\LogLens.Infrastructure.csproj" />
  </ItemGroup>

</Project>
